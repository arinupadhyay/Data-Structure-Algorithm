#include <iostream>

using namespace std;

void insertion_sort(int arr[], int n)
{
    int temp;
    int j;

    for(int i = 0; i <= n - 1; i++)
    {
        j = i;

        while(j > 0 && arr[j - 1] > arr[j])
        {
            // swap arr[j-1] and arr[j]
            temp = arr[j];
            arr[j] = arr[j - 1];
            arr[j - 1] = temp;

            j = j - 1;
        }
    }
}

int main()
{
    int n;

    cout << "Enter the size of the array: ";
    cin >> n;

    int arr[100];

    // taking input of the array
    for(int i = 0; i < n; i++)
    {
        cin >> arr[i];
    }

    insertion_sort(arr, n);

    // printing sorted array
    cout << "Sorted array: ";

    for(int i = 0; i < n; i++)
    {
        cout << arr[i] << " ";
    }

    return 0;
}
